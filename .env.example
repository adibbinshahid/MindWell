# ── Local dev (SQLite) ──────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── Production (Turso — SQLite in the cloud, stays on Vercel) ───────
# Get these from: https://turso.tech  (free tier is generous)
# TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
# TURSO_AUTH_TOKEN="eyJ..."

# ── NextAuth ─────────────────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
# Local:
NEXTAUTH_URL="http://localhost:3000"
# Vercel: set to your live domain
# NEXTAUTH_URL="https://your-app.vercel.app"

# ── Admin seed credentials ────────────────────────────────────────────
ADMIN_EMAIL="admin@mindwellclinic.com"
ADMIN_PASSWORD="Admin@Mindwell2024"
