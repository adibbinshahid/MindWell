# ── Neon / PostgreSQL (production + Vercel) ─────────────────────────
# Get both from: neon.com → Project → Dashboard → Connect
#
# DATABASE_URL  → Pooled connection (host contains "-pooler") — used by app at runtime
# DIRECT_URL    → Direct connection (no "-pooler") — used by prisma migrate/db push
#
# Neon free plan never pauses permanently: compute scales to zero after ~5 min
# idle and auto-resumes on the next query. No manual unpause, no keep-alive ping.
#
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── NextAuth ──────────────────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
# Local:
NEXTAUTH_URL="http://localhost:3000"
# Vercel: set to your live domain
# NEXTAUTH_URL="https://your-app.vercel.app"

# ── Vercel Blob (image uploads) ───────────────────────────────────────
# Create a Blob store: Vercel dashboard → Storage → Create → Blob, then connect
# it to this project. Vercel injects BLOB_READ_WRITE_TOKEN automatically on
# deploys — you only need it here for local dev (copy from the store's settings).
# If unset, uploads fall back to writing into public/uploads (dev only).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── Admin seed credentials ────────────────────────────────────────────
ADMIN_EMAIL="admin@mindwellclinic.com"
ADMIN_PASSWORD="Admin@Mindwell2024"
