# ── Supabase / PostgreSQL (production + Vercel) ──────────────────────
# Get both from: supabase.com → Project → Settings → Database → Connection string
#
# DATABASE_URL  → Transaction pooler (port 6543) — used by app at runtime
# DIRECT_URL    → Direct connection  (port 5432) — used by prisma migrate/push
#
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].supabase.com:5432/postgres"

# ── NextAuth ──────────────────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
# Local:
NEXTAUTH_URL="http://localhost:3000"
# Vercel: set to your live domain
# NEXTAUTH_URL="https://your-app.vercel.app"

# ── Admin seed credentials ────────────────────────────────────────────
ADMIN_EMAIL="admin@mindwellclinic.com"
ADMIN_PASSWORD="Admin@Mindwell2024"
